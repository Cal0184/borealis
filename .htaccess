# Used only when the hosting document root is this folder instead of public/.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|config|database|storage|storage-[a-f0-9]+|bin|tests|docs|extras)(/|$) - [F,L]
  RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.|\.(sql|md|log|lock)$">
  Require all denied
</FilesMatch>
